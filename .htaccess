# Custom 404 Page (Served from 404.html)
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
</IfModule>

<FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|otf)$">
    Require all granted
</FilesMatch>

Options -MultiViews
RewriteEngine On
RewriteBase /

# Force HTTPS on Live Server (Ignored on localhost/XAMPP)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

# ---------------------------------------------------------
# ASSET ROUTING (Points subfolder asset calls to assets/)
# ---------------------------------------------------------
RewriteCond %{REQUEST_URI} !^/assets/
RewriteRule ^.*/assets/(.*)$ /assets/$1 [L,NC]

# ---------------------------------------------------------
# 301 REDIRECTIONS FOR OLD / BROKEN / 404 URLS
# ---------------------------------------------------------

# 1. Root & Index
RewriteCond %{THE_REQUEST} /index(?:\.html)?[\s\?] [NC]
RewriteRule ^(.*)index(?:\.html)?$ / [R=301,L]

# Explore Us Text Fragment / Query String Redirect
RewriteCond %{QUERY_STRING} text=Explore [NC]
RewriteRule ^ https://alphabitinfoway.com/ [R=301,L]

# 2. Technology -> /ai-development-technologies
RewriteRule ^technology/?$ /ai-development-technologies [R=301,L,NC]

# 3. Developer hiring pages
RewriteRule ^hire-dedicated-developer/?$ /hire-developers [R=301,L,NC]
RewriteRule ^hire-software-developer/?$ /hire-developers [R=301,L,NC]

# 4. Legacy .shtml / .php / old pages
RewriteRule ^about\.shtml$ /aboutus [R=301,L,NC]
RewriteRule ^about/?$ /aboutus [R=301,L,NC]
RewriteRule ^services\.shtml$ /services [R=301,L,NC]
RewriteCond %{THE_REQUEST} \s/contact\.(?:php|html)[\s\?] [NC]
RewriteRule ^ /contact-us [R=301,L]
RewriteRule ^contact/?$ /contact-us [R=301,L,NC]
RewriteRule ^ai-machine-learning\.php$ /ai-and-machine-learning-development-services [R=301,L,NC]
RewriteRule ^ai-mobile-app-development-services\.htm$ /ai-mobile-app-development-services [R=301,L,NC]

# 5. Inactive / removed old URLs -> Home (/)
RewriteRule ^entrepreneur/?$ / [R=301,L,NC]
RewriteRule ^e-commerce/?$ / [R=301,L,NC]
RewriteRule ^training-master/?$ / [R=301,L,NC]
RewriteRule ^business-branding/?$ / [R=301,L,NC]
RewriteRule ^indur?strial-service-provider/?$ / [R=301,L,NC]
RewriteRule ^webdevelopment/?$ / [R=301,L,NC]

# 6. Products anchor -> /#products
RewriteRule ^products/?$ /#products [R=301,NE,L,NC]

# 7. Careers
RewriteRule ^careers/?$ /career [R=301,L,NC]

# 8. Case Study Old URLs
RewriteRule ^case-study-ecommerce/?$ /case-studies [R=301,L,NC]
RewriteRule ^case-study-1/?$ /case-studies [R=301,L,NC]
RewriteRule ^case-study/case-study-ecommerce/?$ /case-studies [R=301,L,NC]
RewriteRule ^case-study/case-study-1/?$ /case-studies [R=301,L,NC]

# 9. Direct Service URLs & 301 Redirects from old service names
RewriteCond %{THE_REQUEST} \s/ai-machine-learning(?:\.html)?[\s\?] [NC]
RewriteRule ^ /ai-and-machine-learning-development-services [R=301,L]

RewriteCond %{THE_REQUEST} \s/cyber-security(?:\.html)?[\s\?] [NC]
RewriteRule ^ /ai-cyber-security-and-compliance-services [R=301,L]
RewriteRule ^services/ai-and-machine-learning-development-services/?$ /ai-and-machine-learning-development-services [R=301,L,NC]
RewriteRule ^services/ai-machine-learning/?$ /ai-and-machine-learning-development-services [R=301,L,NC]
RewriteRule ^services/ai-cyber-security-and-compliance-services/?$ /ai-cyber-security-and-compliance-services [R=301,L,NC]
RewriteRule ^services/cyber-security/?$ /ai-cyber-security-and-compliance-services [R=301,L,NC]
RewriteRule ^services/ai-full-stack-development-services/?$ /ai-full-stack-development-services [R=301,L,NC]
RewriteRule ^services/ai-mobile-app-development-services/?$ /ai-mobile-app-development-services [R=301,L,NC]

# 10. Specific Blog Redirections
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{QUERY_STRING} ^slug=beyond-code [NC]
RewriteRule ^blogdetails(?:\.html)?$ /blogs/role-of-web-developer-in-business? [R=301,L]
RewriteRule ^(?:blogs|blog-details)/beyond-code.*$ /blogs/role-of-web-developer-in-business [R=301,L,NC]

RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{QUERY_STRING} ^slug=ai-voice-agents-for-business [NC]
RewriteRule ^blogdetails(?:\.html)?$ /blogs/genie-dial-ai-voice-agent-for-business-calls? [R=301,L]
RewriteRule ^(?:blogs|blog-details)/ai-voice-agents-for-business/?$ /blogs/genie-dial-ai-voice-agent-for-business-calls [R=301,L,NC]

RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{QUERY_STRING} ^slug=how-e-commerce [NC]
RewriteRule ^blogdetails(?:\.html)?$ /blogs/ai-mobile-apps-for-ecommerce-2026-to-boost-sales-retention? [R=301,L]
RewriteRule ^(?:blogs|blog-details)/how-e-commerce.*$ /blogs/ai-mobile-apps-for-ecommerce-2026-to-boost-sales-retention [R=301,L,NC]
RewriteRule ^how-e-commerce-.*$ /blogs/ai-mobile-apps-for-ecommerce-2026-to-boost-sales-retention [R=301,L,NC]

# Generic blog query string redirect: blogdetails?slug=xxx -> /blogs/xxx
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{QUERY_STRING} ^slug=([^&]+) [NC]
RewriteRule ^blogdetails(?:\.html)?$ /blogs/%1? [R=301,L]

# Generic casestudy query string redirect: casestudydetails?slug=xxx -> /case-study/xxx
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{QUERY_STRING} ^slug=([^&]+) [NC]
RewriteRule ^casestudydetails(?:\.html)?$ /case-study/%1? [R=301,L]

# Blog root redirects
RewriteRule ^blog/?$ /blogs [R=301,L,NC]
RewriteCond %{THE_REQUEST} \s/blog\.html[\s\?] [NC]
RewriteRule ^ /blogs [R=301,L]

# Strip .html extension from direct requests (e.g. /dhiread.html -> /dhiread)
RewriteCond %{THE_REQUEST} /([^/]+)\.html[\s\?] [NC]
RewriteCond %1 !^(index|404)$ [NC]
RewriteRule ^ /%1 [NC,L,R=301]

# Remove trailing slashes (unless directory)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [L,R=301]

# ---------------------------------------------------------
# REAL FILE PASSTHROUGH
# ---------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ---------------------------------------------------------
# INTERNAL REWRITES (Clean URL to Physical File Mapping)
# ---------------------------------------------------------

# Core Pages
RewriteRule ^aboutus/?$ about.html [L]
RewriteRule ^blogs/?$ blog.html [L]
RewriteRule ^blogs/([^/]+)/?$ blogdetails.html?slug=$1 [NC,L,QSA]
RewriteRule ^blog-details/([^/]+)/?$ blogdetails.html?slug=$1 [NC,L,QSA]
RewriteRule ^case-studies/?$ case-studies.html [L]
RewriteRule ^case-study/([^/]+)/?$ casestudydetails.html?slug=$1 [NC,L,QSA]
RewriteRule ^casestudydetails/?$ casestudydetails.html [L]
RewriteRule ^contact-us/?$ contact.html [L]
RewriteRule ^services/?$ services.html [L]
RewriteRule ^career/?$ career.html [L]
RewriteRule ^hire-developers/?$ hire-developers.html [L]

# Service Mappings
RewriteRule ^ai-and-machine-learning-development-services/?$ ai-machine-learning.html [L]
RewriteRule ^ai-cyber-security-and-compliance-services/?$ cyber-security.html [L]
RewriteRule ^ai-full-stack-development-services/?$ ai-full-stack-development-services.html [L]
RewriteRule ^ai-mobile-app-development-services/?$ ai-mobile-app-development-services.html [L]

# Match existing .html pages without extension
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f [OR]
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# ---------------------------------------------------------
# 404 ERROR HANDLING FOR NON-EXISTENT URLS
# ---------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html !-f
RewriteRule ^ - [R=404,L]

# ----------------------------------------------------------------------
# | Compression & Caching Headers                                      |
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/x-font-ttf application/vnd.ms-fontobject font/opentype font/ttf font/otf image/svg+xml image/x-icon
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|otf)$">
        Header set Cache-Control "max-age=31536000, public, no-transform"
    </FilesMatch>
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    Header unset ETag
    Header set Connection keep-alive
</IfModule>
FileETag None

Options -Indexes
